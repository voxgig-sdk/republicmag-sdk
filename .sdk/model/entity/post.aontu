# Entity: post

main: kit: entity: post: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: false
      type: "`$STRING`"
    }
    {
      name: "category"
      req: false
      type: "`$STRING`"
    }
    {
      name: "content"
      req: false
      type: "`$STRING`"
    }
    {
      name: "excerpt"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "imageUrl"
      req: false
      type: "`$STRING`"
    }
    {
      name: "publishedAt"
      req: true
      type: "`$STRING`"
    }
    {
      name: "tags"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "title"
      req: true
      type: "`$STRING`"
    }
    {
      name: "updatedAt"
      req: false
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "post"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/api/posts/recent"
          parts: [
            "api"
            "posts"
            "recent"
          ]
          select: {
            "$action": "recent"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
